---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, getTags } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return getTags(posts).map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`# ${tag}`}><div class="container page-content"><header class="page-heading"><a class="back-link" href="/">← 所有文章</a><h1><span class="tag-hash">#</span> {tag}</h1><p>在这个话题下，收集了 {posts.length} 篇记录。</p></header><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div><a class="text-link tag-back" href="/">探索更多文章 <Icon name="arrow" size={16} /></a></div></BaseLayout>
