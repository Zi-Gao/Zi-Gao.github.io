---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, postUrl, formatDate, readingTime } from '../../lib/posts';
import { site } from '../../site.config';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const related = (await getPosts()).filter((item) => item.id !== post.id)
  .sort((a, b) => Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category)).slice(0, 2);
const labels: string[] = Array.isArray(remarkPluginFrontmatter?.tocLabels) ? remarkPluginFrontmatter.tocLabels : [];
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading, index) => ({ ...heading, text: labels[index] || heading.text }));
const structuredData = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: post.data.title, description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: site.author },
  mainEntityOfPage: new URL(postUrl(post), Astro.site).href,
  ...(post.data.cover ? { image: new URL(post.data.cover, Astro.site).href } : {}),
};
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\u003c')} />
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="container article-page">
    <header class="article-header"><a class="back-link" href="/">← 回到所有文章</a><div class="post-meta"><a href={`/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a><span class="meta-separator">/</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span class="meta-separator">/</span><span>{readingTime(post.body)} 分钟阅读</span></div><h1>{post.data.title}</h1><div class="article-author"><span>{site.author}</span><button class="share-button" data-share><Icon name="link" size={17} /><span>复制链接</span></button></div><span class="sr-only" data-share-status aria-live="polite"></span></header>
    <div class="article-layout"><div><div class="prose"><Content /></div><div class="article-end"><div class="article-tags">{post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}># {tag}</a>)}</div></div></div>{toc.length > 0 && <aside class="article-toc" aria-label="文章目录"><h2>目录</h2><nav>{toc.map((heading) => <a href={`#${heading.slug}`} class:list={{ nested: heading.depth === 3 }} data-toc-link>{heading.text}</a>)}</nav><a class="toc-top" href="#main">回到顶部 ↑</a></aside>}</div>
  </article>
  {related.length > 0 && <section class="container related-section"><div class="section-heading"><div><h2>继续阅读</h2></div><a class="text-link" href="/">所有文章 <Icon name="arrow" size={17} /></a></div><div class="post-grid related-grid">{related.map((item) => <PostCard post={item} headingLevel="h3" />)}</div></section>}
</BaseLayout>
<script>
  const share = document.querySelector<HTMLButtonElement>('[data-share]');
  share?.addEventListener('click', async () => {
    const label = share.querySelector('span');
    const status = document.querySelector('[data-share-status]');
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (label) label.textContent = '已复制';
      if (status) status.textContent = '文章链接已复制到剪贴板';
      window.setTimeout(() => { if (label) label.textContent = '复制链接'; }, 2000);
    } catch {
      if (label) label.textContent = '请复制地址栏链接';
      if (status) status.textContent = '无法访问剪贴板，请复制浏览器地址栏中的文章链接';
    }
  });

  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
    const code = pre.querySelector('code');
    if (!code) return;
    const button = document.createElement('button');
    button.className = 'code-copy'; button.textContent = '复制'; button.setAttribute('aria-label', '复制代码');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent || '');
        button.textContent = '已复制';
        window.setTimeout(() => { button.textContent = '复制'; }, 2000);
      } catch { button.textContent = '请手动复制'; }
    });
    pre.append(button);
  });

  const progress = document.querySelector<HTMLElement>('.reading-progress');
  const updateProgress = () => {
    const article = document.querySelector('.article-layout');
    if (!progress || !article) return;
    const total = article.getBoundingClientRect().bottom + window.scrollY - window.innerHeight;
    progress.style.transform = `scaleX(${Math.min(1, Math.max(0, window.scrollY / Math.max(total, 1)))})`;
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();

  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((link) => {
          const active = decodeURIComponent(link.hash.slice(1)) === entry.target.id;
          link.classList.toggle('active', active);
          if (active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
        });
      }
    }, { rootMargin: '-15% 0px -65% 0px' });
    document.querySelectorAll('.prose h2, .prose h3').forEach((heading) => observer.observe(heading));
  }
</script>
