---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import PostFilter from '../components/PostFilter.astro';
import { getPosts, postUrl, readingTime, formatDate, getCategoryCounts } from '../lib/posts';
import { site } from '../site.config';
const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) || posts[0];
const recent = posts.filter((post) => post.id !== featured?.id).slice(0, 6);
const counts = getCategoryCounts(recent);
---
<BaseLayout>
  <div class="container">
    <section class="hero">
      <div class="hero-main"><p class="eyebrow hero-eyebrow"><span class="status-dot"></span> {site.tagline}</p><h1>记录，思考，<br />以及生活的<span class="serif-word">留白<span class="word-underline" aria-hidden="true"></span></span>。</h1></div>
      <div class="hero-aside"><div class="hero-flower" aria-hidden="true"><svg viewBox="0 0 100 100" fill="none"><path d="M50 8v84M8 50h84M20 20l60 60M20 80l60-60" stroke="currentColor" stroke-width="14" /><circle cx="50" cy="50" r="8" fill="#fff" /></svg></div><p>一些算法题解、学习笔记与生活游记。<br />把复杂想明白，也把日常记下来。</p><a class="text-link" href="/about/">认识一下 <Icon name="arrow-up" size={15} /></a></div>
    </section>

    {featured && <section class="featured-section" aria-labelledby="featured-heading">
      <div class="section-caption"><h2 id="featured-heading"><Icon name="spark" size={14} /> 编辑精选</h2><span>A LITTLE SOMETHING WORTH READING</span></div>
      <article class="featured-card">
        <a class="featured-image" href={postUrl(featured)} tabindex="-1" aria-hidden="true"><img src={featured.data.cover || '/images/quiet-space.svg'} alt="" width="720" height="480" fetchpriority="high" /><span class="featured-image-label">COMPREHENSION IS COMPRESSION.<span>01 — JOURNAL</span></span></a>
        <div class="featured-content"><div class="post-meta"><span class="category-dot"></span><a href={`/blog/?category=${encodeURIComponent(featured.data.category)}`}>{featured.data.category}</a><span class="featured-badge">精选文章</span></div><h2><a href={postUrl(featured)}>{featured.data.title}</a></h2><p>{featured.data.description}</p><div class="featured-bottom"><div class="featured-date"><time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time><span>·</span><span>{readingTime(featured.body)} 分钟阅读</span></div><a class="round-link" href={postUrl(featured)} aria-label={`阅读：${featured.data.title}`}><Icon name="arrow-up" size={21} /></a></div></div>
      </article>
    </section>}

    <section class="latest-section" aria-labelledby="latest-heading">
      <div class="section-heading"><div><p class="eyebrow">THE JOURNAL</p><h2 id="latest-heading">最近写下的<span class="heading-period">.</span></h2></div><a class="text-link" href="/blog/">所有文章 <Icon name="arrow" size={17} /></a></div>
      <PostFilter counts={counts} />
      <p class="sr-only" data-filter-status aria-live="polite"></p>
      <div class="post-grid">{recent.map((post) => <PostCard post={post} />)}</div>
      <p class="empty-state" data-filter-empty hidden>这个分类还没有新的记录，去看看其他文章吧。</p>
    </section>

    <section class="closing-note"><div class="closing-icon"><Icon name="book" size={26} /></div><div><p class="eyebrow">WORDS, AT THEIR OWN PACE.</p><h2>不定期更新，但一直在记录。</h2><p>如果你也喜欢这些文字，我们可以在下一篇文章里再见。</p></div><a class="button button-light" href="/rss.xml"><Icon name="rss" size={16} /> 订阅 RSS <Icon name="arrow-up" size={16} /></a></section>
  </div>
</BaseLayout>
