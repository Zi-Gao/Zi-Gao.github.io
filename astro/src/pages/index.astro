---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
const posts = await getPosts();
---
<BaseLayout>
  <div class="container home-content">
    <header class="home-heading"><h1>文章</h1></header>
    <div class="post-grid home-post-grid">{posts.map((post) => <PostCard post={post} />)}</div>
  </div>
  <script>
    import { site } from '../site.config';
    const category = new URLSearchParams(window.location.search).get('category');
    if (category && site.categories.some((item) => item === category)) {
      window.location.replace(`/categories/${encodeURIComponent(category)}/`);
    }
  </script>
</BaseLayout>
