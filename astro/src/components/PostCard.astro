---
import type { Post } from '../lib/posts';
import { postUrl, formatDate } from '../lib/posts';
interface Props { post: Post; }
const { post } = Astro.props;
---
<article class="post-card" data-post-card data-category={post.data.category}>
  <div class="post-card-body">
    <div class="post-meta"><a href={`/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.pinned && <span class="pinned-badge">置顶</span>}</div>
    <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
    <p class="post-description">{post.data.description}</p>

  </div>
</article>
