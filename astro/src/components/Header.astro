---
import Icon from './Icon.astro';
import { site } from '../site.config';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/archive/', label: '时间归档' },
];
---
<header class="site-header">
  <div class="header-inner container">
    <a class="wordmark" href="/" aria-label={`${site.title}，回到首页`}>
      <span>{site.title}</span>
      <span class="brand-tagline">{site.tagline}</span>
    </a>
    <div class="header-right">
      <nav class="desktop-nav" aria-label="主导航">
        {links.map(({ href, label }) => <a href={href} class:list={{ active: href === '/' ? path === '/' : path.startsWith(href) }} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <button class="search-trigger" data-search-open aria-label="搜索文章"><Icon name="search" size={18} /></button>
      <button class="icon-button mobile-menu-toggle" aria-label="打开导航" aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu" /></button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav container" aria-label="移动导航" hidden>
    {links.map(({ href, label }) => <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}<Icon name="arrow-up" size={16} /></a>)}
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    toggle.setAttribute('aria-label', expanded ? '打开导航' : '关闭导航');
    if (menu) menu.hidden = expanded;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) {
      menu.hidden = true;
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', '打开导航');
      toggle?.focus();
    }
  });
</script>
