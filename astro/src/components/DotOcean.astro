<canvas class="dot-ocean" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.dot-ocean');
  const context = canvas?.getContext('2d');
  if (canvas && context) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = matchMedia('(pointer: fine)');
    const forcedColors = matchMedia('(forced-colors: active)');
    let width = 0;
    let height = 0;
    let frame = 0;
    let lastTime = 0;
    let phase = 0;
    let pointerX = -1000;
    let pointerY = -1000;
    let strength = 0;
    let targetStrength = 0;

    function draw() {
      if (!context) return;
      context.clearRect(0, 0, width, height);
      if (forcedColors.matches) return;
      const spacing = width < 600 ? 20 : 18;
      const readingHalf = Math.min(370, (width - 44) / 2);
      // Wrap the grid by one cell so the entire field drifts without a reset.
      const driftX = (phase * 22) % spacing;
      const driftY = (phase * 11) % spacing;
      for (let row = -spacing * 2; row < height + spacing; row += spacing) {
        for (let column = -spacing * 2; column < width + spacing; column += spacing) {
          const x = column + driftX;
          const y = row + driftY;
          // Broad swells crossed by smaller ripples form curved wave fronts.
          const swell = Math.sin(x * .012 + y * .018 - phase * 1.3);
          const ripple = Math.sin(x * -.019 + y * .011 - phase * .8);
          const wave = swell * .75 + ripple * .25;
          let dx = Math.cos(y * .014 + x * .006 - phase * .9) * 6;
          let dy = swell * 12 + ripple * 4;
          const px = x - pointerX;
          const py = y - pointerY;
          const distance = Math.hypot(px, py);
          const influence = Math.max(0, 1 - distance / 155) ** 2 * strength;
          if (distance > 0) {
            dx += px / distance * influence * 7;
            dy += py / distance * influence * 7;
          }
          const edge = Math.max(0, Math.min(1, (Math.abs(x - width / 2) - readingHalf + 24) / 150));
          const crest = (wave + 1) / 2;
          const alpha = (.035 + edge * .145) * (.65 + crest * .55);
          context.fillStyle = `rgba(83, 122, 151, ${alpha})`;
          context.beginPath();
          context.arc(x + dx, y + dy, .75 + crest * .35 + influence * .15, 0, Math.PI * 2);
          context.fill();
        }
      }
    }

    function animate(time: number) {
      if (time - lastTime >= 1000 / 30) {
        const elapsed = lastTime ? Math.min(time - lastTime, 80) : 0;
        phase += elapsed * .00016;
        strength += (targetStrength - strength) * .08;
        lastTime = time;
        draw();
      }
      frame = requestAnimationFrame(animate);
    }

    function syncAnimation() {
      cancelAnimationFrame(frame);
      lastTime = 0;
      strength = 0;
      draw();
      if (!document.hidden && !reducedMotion.matches && !forcedColors.matches) {
        frame = requestAnimationFrame(animate);
      }
    }

    function resize() {
      if (!canvas || !context) return;
      width = window.innerWidth;
      height = window.innerHeight;
      const scale = Math.min(devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(width * scale);
      canvas.height = Math.round(height * scale);
      context.setTransform(scale, 0, 0, scale, 0, 0);
      draw();
    }

    window.addEventListener('pointermove', (event) => {
      if (!finePointer.matches || reducedMotion.matches || event.pointerType === 'touch') return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      targetStrength = 1;
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => { targetStrength = 0; });
    window.addEventListener('blur', () => { targetStrength = 0; });
    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', syncAnimation);
    reducedMotion.addEventListener('change', syncAnimation);
    forcedColors.addEventListener('change', syncAnimation);
    window.addEventListener('pagehide', () => cancelAnimationFrame(frame));
    window.addEventListener('pageshow', syncAnimation);
    resize();
    syncAnimation();
  }
</script>
