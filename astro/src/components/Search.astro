---
import Icon from './Icon.astro';
---
<dialog class="search-dialog" aria-labelledby="search-heading">
  <div class="search-dialog-top"><Icon name="search" size={22} /><h2 id="search-heading" class="sr-only">搜索文章</h2><label class="sr-only" for="search-input">输入关键词</label><input id="search-input" type="search" placeholder="搜索文章、标签或某个想法…" autocomplete="off" /><button class="icon-button" data-search-close aria-label="关闭搜索"><Icon name="close" size={18} /></button></div>
  <div class="search-results" aria-live="polite" aria-atomic="true"><p class="search-hint">输入关键词，发现一些值得阅读的文字。</p></div>
  <div class="search-dialog-bottom"><span>探索文字里的小小世界</span><span><kbd>esc</kbd> 关闭</span></div>
</dialog>
<script>
  type SearchPost = { title: string; description: string; tags: string[]; category: string; url: string; text: string };
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const results = document.querySelector<HTMLDivElement>('.search-results');
  let posts: SearchPost[] | undefined;
  let request: Promise<SearchPost[]> | undefined;
  let searchVersion = 0;
  const openSearch = () => { dialog?.showModal(); input?.focus(); };
  document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', openSearch));
  document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      event.preventDefault();
      dialog.close();
    }
  });
  dialog?.addEventListener('click', (event) => {
    const box = dialog.getBoundingClientRect();
    if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog?.open) dialog.close(); else openSearch();
    }
  });
  input?.addEventListener('input', async () => {
    const version = ++searchVersion;
    const query = input.value.trim().toLocaleLowerCase();
    if (!results) return;
    if (!query) {
      results.innerHTML = '<p class="search-hint">输入关键词，发现一些值得阅读的文字。</p>';
      return;
    }
    results.innerHTML = '<p class="search-hint">正在寻找…</p>';
    try {
      request ??= fetch('/search.json').then((response) => {
        if (!response.ok) throw new Error('Search unavailable');
        return response.json() as Promise<SearchPost[]>;
      }).catch((error: unknown) => { request = undefined; throw error; });
      posts ??= await request;
      if (version !== searchVersion) return;
      const tokens = query.split(/\s+/);
      const matched = posts.filter((post) => {
        const haystack = `${post.title} ${post.description} ${post.tags.join(' ')} ${post.category} ${post.text}`.toLocaleLowerCase();
        return tokens.every((token) => haystack.includes(token));
      });
      results.replaceChildren();
      if (!matched.length) {
        const empty = document.createElement('p');
        empty.className = 'search-hint';
        empty.textContent = `没有找到与「${input.value.trim()}」有关的文章，换个词试试吧。`;
        results.append(empty);
      }
      matched.slice(0, 12).forEach((post) => {
        const link = document.createElement('a');
        link.href = post.url;
        link.className = 'search-result';
        const category = document.createElement('span'); category.className = 'search-result-category'; category.textContent = post.category;
        const title = document.createElement('strong'); title.textContent = post.title;
        const description = document.createElement('p'); description.textContent = post.description;
        link.append(title, category, description); results.append(link);
      });
    } catch {
      if (version === searchVersion) results.innerHTML = '<p class="search-hint">搜索暂时不可用，请稍后再试。</p>';
    }
  });
</script>
